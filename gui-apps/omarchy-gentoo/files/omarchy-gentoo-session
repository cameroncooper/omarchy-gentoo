#!/bin/bash
set -euo pipefail

export OMARCHY_PATH=/usr/share/omarchy
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=Hyprland
export XDG_SESSION_DESKTOP=Hyprland
# Omarchy relies on the platform's normal pointer theme. Gentoo does not
# install a system-wide "default" cursor alias, so select packaged Adwaita
# unless the user already chose another XCursor theme.
export XCURSOR_THEME="${XCURSOR_THEME:-Adwaita}"
# Packaged commands must win over prototype-era ~/.local copies. Keep user
# tools available, but append them as upstream's env-bootstrap does.
export PATH="/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
[[ ! -d $HOME/.local/share/mise/shims ]] ||
  PATH="$PATH:$HOME/.local/share/mise/shims"
[[ ! -d $HOME/.local/bin ]] || PATH="$PATH:$HOME/.local/bin"

omarchy-user-init --if-needed

# Gentoo installs user units without enabling them. Start the multimedia
# services required by the shell and screencast portal for this session.
if command -v systemctl >/dev/null 2>&1; then
  media_units=(pipewire.socket wireplumber.service)
  if systemctl --user list-unit-files pipewire-pulse.socket \
      --no-legend >/dev/null 2>&1; then
    media_units+=(pipewire-pulse.socket)
  fi
  systemctl --user start "${media_units[@]}" || \
    echo "omarchy-gentoo-session: warning: could not start PipeWire services" >&2
fi

[[ -s ${XDG_CONFIG_HOME:-$HOME/.config}/hypr/hyprland.lua ]] || {
  echo "omarchy-gentoo-session: user initialization did not create hyprland.lua" >&2
  exit 1
}

watchdog=""
for candidate in /usr/bin/start-hyprland /bin/start-hyprland; do
  if [[ -x $candidate ]]; then
    watchdog="$candidate"
    break
  fi
done

[[ -n $watchdog ]] || {
  echo "omarchy-gentoo-session: Hyprland watchdog not found" >&2
  exit 1
}

cd "$HOME"
exec "$watchdog" "$@"
